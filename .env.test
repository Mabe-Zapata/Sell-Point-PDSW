# Application
NODE_ENV=development
APP_MODE=local
PORT=3000

# Database
DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sellpoint
POSTGRES_PASSWORD=sellpoint
POSTGRES_DB=sellpoint
POSTGRES_USER_PROD=sellpoint
POSTGRES_PASSWORD_PROD=sellpoint
POSTGRES_DB_PROD=sellpoint_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-min-32-chars

# Auth lockout
AUTH_MAX_FAILED_ATTEMPTS=5

# Public IP fallback
PUBLIC_IP_TIMEOUT_MS=1500

# Tax
IVA_PERCENTAGE=15

# Brevo Email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@sellpoint.com
BREVO_SENDER_NAME=Sell Point
BREVO_TEMPLATE_ORDER_CONFIRMATION_ID=1
BREVO_TEMPLATE_SALE_CANCELLED_ID=2
BREVO_TEMPLATE_INVOICE_ID=3

# Firebase Admin SDK (para autenticacion Google OAuth en backend)
# Path al archivo JSON del service account de Firebase Admin
FIREBASE_ADMIN_SDK_PATH=/path/to/firebase-admin-sdk.json

# Docker Secrets (para Docker Swarm)
# FIREBASE_ADMIN_SDK_VOLUME=./firebase-admin-sdk.json:/run/secrets/firebase-admin-sdk.json:ro
